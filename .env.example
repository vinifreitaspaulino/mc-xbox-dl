# mc-xbox-dl Environment Configuration (Optional)
# Copy this file to .env or set environment variables in your shell if you wish
# to override the default public Minecraft Bedrock OAuth client parameters.

# Client ID for Microsoft Account OAuth Device Flow (Default: Minecraft Bedrock Android)
# MC_XBOX_DL_CLIENT_ID=0000000048183522

# Service Configuration ID (SCID) for Minecraft Bedrock Title Storage
# MC_XBOX_DL_SCID=00000000-0000-0000-0000-00006cfa0c1e

# Package Family Name (PFN)
# MC_XBOX_DL_PFN=Microsoft.186805A1E9E_8wekyb3d8bbwe

# Xbox Title ID
# MC_XBOX_DL_TITLE_ID=1828326430

# Custom path to settings file (defaults to OS user roaming app data)
# MC_XBOX_DL_SETTINGS_FILE=

# Custom path to cache file (defaults to OS user roaming app data)
# MC_XBOX_DL_CACHE_FILE=
